#!/bin/bash

ODOO_ROOT="$HOME/Dev/odoo"
GLOBAL_DB="$HOME/.current_db"
ODOO_CONF="$HOME/.odoorc"
WS_SETTINGS=".wtenv"

if [ $# -lt 1 ]; then
    >&2 echo "Needs 1 parameter (db_name)"
    exit 1
fi

workspace_settings_here() {
    local dir="$PWD"
    while [[ "$dir" == "$ODOO_ROOT" || "$dir" == "$ODOO_ROOT"/* ]]; do
        [ -f "$dir/$WS_SETTINGS" ] && { echo "$dir/$WS_SETTINGS"; return 0; }
        dir=$(dirname "$dir")
    done
    return 1
}

set_key() {  # set_key <file> <key> <value>
    if grep -q "^$2=" "$1"; then
        sed -i '' "s|^$2=.*|$2=$3|" "$1"
    else
        echo "$2=$3" >> "$1"
    fi
}

if settings=$(workspace_settings_here); then
    set_key "$settings" db "$1"
    echo "$1 (workspace $(basename "$(dirname "$settings")"))"
    exit 0
fi

[ -f "$ODOO_CONF" ] && sed -i '' "s/db_name =.*/db_name = $1/g" "$ODOO_CONF"
echo "$1" > "$GLOBAL_DB"
